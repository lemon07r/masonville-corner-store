<header class="site-header" aria-label="Primary">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">
      {% image "logo-minimal.png", "Astraea Fabrication logo", "120px", "eager", "high" %}
      <span class="site-header__text">
        <strong>{{ store.name }}</strong>
      </span>
    </a>
    <button class="site-header__toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="hamburger"></span>
    </button>
    <nav class="site-header__nav" aria-label="Site">
      <a href="#hero" class="site-header__link">Home</a>
      <a href="#services" class="site-header__link">Services</a>
      <a href="#work" class="site-header__link">Work</a>
      <a href="#contact" class="site-header__link">Contact</a>
    </nav>
    <a class="btn site-header__cta" href="#contact">Get a Quote</a>
  </div>
</header>
